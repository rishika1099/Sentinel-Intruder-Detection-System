# Copy this file to .env and fill in your email settings.
# For Gmail: create an "App Password" (Google Account > Security > 2-Step
# Verification > App passwords) and use that as SMTP_PASSWORD, NOT your
# normal Google password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_FROM=youraddress@gmail.com
ALERT_TO=owner@example.com

# Optional: Claude API key for the AI analyst (natural-language threat
# descriptions + incident Q&A). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

